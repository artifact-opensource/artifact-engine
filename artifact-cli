import sys
import os

# Add src to path
sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'src'))

from training.terminal_ui import create_cli, ArtifactTrainer, TrainingConfig

def main():
    """Main CLI entry point"""
    console = create_cli()
    
    # Example usage
    config = TrainingConfig(
        model_name="artifact-gpt",
        model_size="7B",
        dataset_path="./data",
